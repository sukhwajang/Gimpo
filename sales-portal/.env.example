# PoC: SQLite. PostgreSQL 전환 시 예) postgresql://user:pass@host:5432/salesportal
DATABASE_URL="file:./dev.db"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"

# 시연용 이메일 로그인(비밀번호 없음). 운영에서는 반드시 false
DEMO_LOGIN="true"

# Microsoft Entra ID SSO (세 값이 모두 있으면 로그인 화면에 Microsoft 버튼이 표시됨)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""
